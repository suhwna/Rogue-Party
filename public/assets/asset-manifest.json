{
  "version": 1,
  "scope": "visual-only",
  "audio": false,
  "directories": {
    "sprites": "/assets/sprites/",
    "icons": "/assets/icons/",
    "effects": "/assets/effects/"
  },
  "style": {
    "genre": "pixel-art fantasy roguelike",
    "renderer": "PixiJS",
    "background": "transparent or pure black",
    "rules": [
      "2D game asset",
      "animation-ready",
      "clean silhouette",
      "high contrast",
      "no text",
      "no logo",
      "no watermark",
      "sprite sheet friendly"
    ]
  },
  "effects": [
    "basic_attack",
    "skill_cast",
    "hit",
    "critical",
    "relic_pickup",
    "level_up",
    "boss_warning",
    "boss_hit",
    "stage_clear",
    "game_over",
    "button_click",
    "map_vote",
    "chest_pickup"
  ],
  "texturePolicy": {
    "priority": [
      "skill effects use external spritesheet assets first",
      "generatedAssets entry with matching textureKey or alias",
      "code-generated Pixi canvas texture fallback for legacy non-skill textures only"
    ],
    "descriptorMissing": "Use generated fallback texture.",
    "descriptorFailure": "Keep generated fallback available and report through renderer diagnostics.",
    "skillEffects": "External spritesheet asset path is the primary skill effect renderer. Canvas-generated effect textures should not be used when an asset sheet exists.",
    "audio": "Excluded. Visual special effects only."
  },
  "textureKeyGuide": {
    "actor": "actor:{classId}:{frame}:{state}",
    "enemy": "enemy:{type}:{frame}",
    "boss": "boss:{bossId}:{phase}:{frame}",
    "projectile": "projectile:{style}",
    "floor": "floor-tile-{chapter}-{variant}",
    "wall": "wall-block-{chapter}",
    "effect": "fx-{effect-name}",
    "common": "shadow | reticle | xp | chest | warning-ring | slash-arc | burst | beam"
  },
  "generatedAssets": [
    {
      "id": "effect-slash-sheet",
      "kind": "effects",
      "file": "effect-slash-sheet.svg",
      "textureKey": "asset-fx-slash",
      "aliases": ["asset-fx-cleave", "asset-fx-spin"],
      "frameWidth": 64,
      "frameHeight": 64,
      "frames": 6,
      "animation": "spritesheet"
    },
